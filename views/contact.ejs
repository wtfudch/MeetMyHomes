<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Contact - MeetMyHomes</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    /* General Styles */
    body {
      font-family: 'Arial', sans-serif;
      line-height: 1.6;
      color: #333;
      background-color: #E5E3DC;
    }

    .container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    h1, h2 {
      font-weight: 700;
      margin-bottom: 1rem;
    }

    h1 { font-size: 2.5rem; }
    h2 { font-size: 2rem; }
    p { font-size: 1.1rem; }

    /* Contact Hero Section */
    .contact-hero {
      background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('/images/home-hero-bg.jpg');
      background-size: cover;
      background-position: center;
      color: white;
      padding: 6rem 0;
      text-align: center;
      margin-bottom: 4rem;
      border-radius: 20px;
    }

    .contact-hero .lead {
      font-size: 1.3rem;
      max-width: 800px;
      margin: 0 auto;
      opacity: 0.9;
    }

    /* Contact Section */
    .contact {
      padding: 3rem 0;
      background-color: #fff;
      border-radius: 20px;
      margin-bottom: 2rem;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .contact-container {
      display: flex;
      align-items: flex-start;
      gap: 2rem;
      flex-wrap: wrap;
    }

    .contact-info, .contact-form {
      flex: 1;
      min-width: 300px;
    }

    .contact-info h2 {
      color: #2c3e50;
    }

    .contact-info p {
      margin-bottom: 1rem;
    }

    .contact-info strong {
      color: #4285F4;
    }

    .contact-map {
      margin-top: 1.5rem;
      border-radius: 10px;
      overflow: hidden;
    }

    .contact-map iframe {
      width: 100%;
      height: 200px;
      border: 0;
      border-radius: 10px;
    }

    .contact-form h2 {
      color: #2c3e50;
      margin-bottom: 1.5rem;
    }

    .form-alert {
      padding: 0.9rem 1.1rem;
      border-radius: 10px;
      font-size: 0.98rem;
      margin-bottom: 1.5rem;
    }

    .form-alert-success {
      background: #e6f4ea;
      color: #1e6b34;
      border: 1px solid #b6e0c3;
    }

    .form-alert-error {
      background: #fdecea;
      color: #a12a24;
      border: 1px solid #f3c1bd;
    }

    .form-group {
      margin-bottom: 1.5rem;
    }

    .form-group label {
      display: block;
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: #333;
    }

    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid #ddd;
      border-radius: 10px;
      font-size: 1rem;
      box-sizing: border-box;
    }

    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }

    button[type="submit"] {
      display: inline-block;
      padding: 0.75rem 2rem;
      background-color: #FF385C;
      color: white;
      text-decoration: none;
      border-radius: 25px;
      font-size: 1.1rem;
      font-weight: 600;
      border: none;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    button[type="submit"]:hover {
      background-color: #E61E4D;
    }

    @media (max-width: 768px) {
      .contact-hero {
        border-radius: 15px;
      }

      .contact {
        border-radius: 15px;
      }

      .contact-container {
        flex-direction: column;
        text-align: center;
      }

      .contact-info,
      .contact-form {
        flex: none;
        width: 100%;
        max-width: 100%;
      }

      .contact-form button[type="submit"] {
        width: 100%;
      }

      .contact-map iframe {
        height: 150px;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <section class="contact-hero">
    <div class="container">
      <h1>Contact Us</h1>
      <p class="lead">Get in touch with MeetMyHomes today</p>
    </div>
  </section>

  <section class="contact">
    <div class="contact-container">
      <!-- Left Side: Contact Information -->
      <div class="contact-info">
        <h2>Contact Information</h2>
        <p><strong>Email:</strong> geral@meetmyhomes.com</p>
        <p><strong>Phone:</strong> (+351) 964 696 600</p>
        <p><strong>Address:</strong> Rua Padre José Eduardo Faria nº30, Funchal, Portugal</p>
        <div class="contact-map">
          <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12788.0493823165!2d-17.1471027!3d32.7138017!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMzLCsDQyJzUwLjYiTiAxN8KwMDgnNDguNCJX!5e0!3m2!1sen!2spt!4v1721813440!5m2!1sen!2spt&markers=color:red%7C32.7139554697555,-17.147203658280024" allowfullscreen="" loading="lazy"></iframe>
        </div>
      </div>

      <!-- Right Side: Contact Form -->
      <div class="contact-form">
        <h2>Send Us a Message</h2>
        <p class="form-alert form-alert-success" id="form-success" style="display:none">Thanks — your message was sent. We'll get back to you soon.</p>
        <p class="form-alert form-alert-error" id="form-error" style="display:none">Something went wrong and your message wasn't sent. Please try again, or email us directly at geral@meetmyhomes.com.</p>
        <form id="contact-form">
          <input type="hidden" name="access_key" value="<%= web3formsKey %>">
          <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

          <div class="form-group">
            <label for="name">Name (required)</label>
            <input type="text" id="name" name="name" placeholder="Your name" required>
          </div>

          <div class="form-group">
            <label for="email">Email (required)</label>
            <input type="email" id="email" name="email" placeholder="Your email" required>
          </div>

          <div class="form-group">
            <label for="message">Message (required)</label>
            <textarea id="message" name="message" rows="5" placeholder="Your message" required></textarea>
          </div>

          <button type="submit" id="contact-submit-btn">Send</button>
        </form>
      </div>
    </div>
  </section>

  <%- include('partials/footer') %>

  <script>
    document.getElementById('contact-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const submitBtn = document.getElementById('contact-submit-btn');
      const successEl = document.getElementById('form-success');
      const errorEl = document.getElementById('form-error');
      successEl.style.display = 'none';
      errorEl.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Sending…';

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const result = await response.json();
        if (result.success) {
          successEl.style.display = 'block';
          form.reset();
        } else {
          console.error('Web3Forms submission failed:', result.message);
          errorEl.style.display = 'block';
        }
      } catch (err) {
        console.error('Web3Forms submission error:', err);
        errorEl.style.display = 'block';
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Send';
      }
    });
  </script>
</body>
</html>