<!DOCTYPE html>
<html lang="pt">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= property.title %> - MeetMyHomes</title>
  <link rel="stylesheet" href="/css/styles.css">
  <% if (property.images && property.images.length > 0) { %>
    <link rel="preload" href="<%= property.images[0] %>" as="image">
  <% } %>
  <script src="/js/propertymaps.js"></script>
  <style>
    .property-container { max-width:1200px; margin:20px auto; padding:20px; background:#fff; border-radius:8px; box-shadow:0 2px 10px rgba(0,0,0,.1); }
    .nav-tabs { display:flex; justify-content:flex-start; margin-bottom:20px; border-bottom:1px solid #eee; position:relative; }
    .nav-tab { padding:12px 20px; cursor:pointer; font-weight:bold; color:#555; border-bottom:3px solid transparent; transition:all .3s; }
    .nav-tab:hover { color:#007bff; }
    .nav-tab.active { color:#007bff; border-color:#007bff; }
    .go-back-button { position:absolute; right:0; top:50%; transform:translateY(-50%); padding:8px 15px; background:#6c757d; color:#fff; text-decoration:none; border-radius:5px; font-size:.9em; transition:background .3s; }
    .go-back-button:hover { background:#5a6268; }
    .tab-content { display:none; padding-top:20px; }
    .tab-content.active { display:block; }
    .main-image-container { text-align:center; margin-bottom:30px; }
    .main-image-container h2 { font-size:2.2em; color:#333; margin-bottom:15px; }
    .main-image { max-width:100%; max-height:500px; object-fit:contain; border-radius:8px; box-shadow:0 4px 15px rgba(0,0,0,.1); }
    .quick-info { display:flex; justify-content:space-around; flex-wrap:wrap; gap:20px; margin-bottom:40px; padding:20px; background:#f8f9fa; border-radius:8px; }
    .info-box { text-align:center; flex:1; min-width:120px; }
    .info-box h3 { font-size:1.1em; color:#6c757d; margin-bottom:8px; }
    .info-box p { font-size:1.6em; font-weight:bold; color:#333; margin:0; }
    .info-box .price { color:#28a745; }
    .info-box .view-map { display:inline-block; margin-top:5px; color:#007bff; text-decoration:none; font-size:.9em; }
    .description-section { margin-bottom:40px; }
    .description-section h2 { font-size:1.8em; color:#333; margin-bottom:20px; border-bottom:2px solid #eee; padding-bottom:10px; }
    .property-description { line-height:1.8; color:#444; }
    .property-description p { margin-bottom:1em; }
    .description-subheader { font-size:1.3em; color:#333; margin-top:1.5em; margin-bottom:.8em; font-weight:600; }
    .description-features { list-style-type:disc; margin-left:25px; margin-bottom:1em; color:#444; }
    .description-features li { margin-bottom:.5em; }
    .detailed-features { display:flex; flex-wrap:wrap; gap:30px; margin-bottom:40px; }
    .feature-category { flex:1 1 calc(50% - 15px); min-width:300px; background:#f8f9fa; padding:20px; border-radius:8px; }
    .feature-category h3 { font-size:1.4em; color:#333; margin-bottom:15px; border-bottom:1px solid #eee; padding-bottom:8px; }
    .feature-category ul { list-style-type:none; padding:0; margin:0; }
    .feature-category li { position:relative; padding-left:25px; margin-bottom:8px; color:#444; }
    .feature-category li::before { content:'✓'; color:#28a745; position:absolute; left:0; font-weight:bold; }
    .gallery-section h2 { font-size:1.8em; color:#333; margin-bottom:20px; border-bottom:2px solid #eee; padding-bottom:10px; }
    .gallery { display:grid; grid-template-columns:repeat(auto-fit, minmax(250px,1fr)); gap:15px; }
    .gallery-item { width:100%; max-height:200px; object-fit:cover; border-radius:8px; box-shadow:0 2px 8px rgba(0,0,0,.1); cursor:pointer; }
    .gallery-item.video { object-fit:contain; background:#000; }
    .lightbox { position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.8); display:none; justify-content:center; align-items:center; z-index:1000; }
    .lightbox img { max-width:90%; max-height:90%; object-fit:contain; }
    .close-lightbox { position:absolute; top:20px; right:20px; font-size:3em; color:#fff; cursor:pointer; }
    .map-section-in-overview { margin-top:40px; padding-top:20px; border-top:2px solid #eee; }
    .map-section-in-overview h2 { font-size:1.8em; color:#333; margin-bottom:20px; border-bottom:2px solid #eee; padding-bottom:10px; }
    #overview-map { height:400px; width:100%; position:relative; border-radius:8px; overflow:hidden; border:1px solid #ddd; }
    .map-loading { position:absolute; top:0; left:0; width:100%; height:100%; display:flex; align-items:center; justify-content:center; background:#f8f9fa; color:#555; font-size:1.2em; z-index:1; }
    .open-in-maps { display:inline-block; margin-top:15px; padding:10px 20px; background:#4285F4; color:#fff; border-radius:5px; font-weight:bold; text-decoration:none; transition:background .3s; }
    .open-in-maps:hover { background:#357ae8; }
    .energy-house { display:inline-block; position:relative; width:24px; height:24px; line-height:24px; text-align:center; color:#fff; font-weight:bold; margin-left:8px; vertical-align:middle; border:2px solid; border-radius:4px 4px 0 0; }
    .energy-house::before { content:''; position:absolute; top:-8px; left:50%; width:0; height:0; border-left:12px solid transparent; border-right:12px solid transparent; border-bottom:8px solid; transform:translateX(-50%); }
    .energy-A,.energy-B { border-color:#28a745; background:#28a745; } .energy-A::before,.energy-B::before { border-bottom-color:#28a745; }
    .energy-C,.energy-D { border-color:#ffc107; background:#ffc107; } .energy-C::before,.energy-D::before { border-bottom-color:#ffc107; }
    .energy-E,.energy-F,.energy-G { border-color:#dc3545; background:#dc3545; } .energy-E::before,.energy-F::before,.energy-G::before { border-bottom-color:#dc3545; }
    @media (max-width:768px) {
      .nav-tabs { flex-direction:column; align-items:flex-start; }
      .nav-tab { width:100%; border-bottom:none; border-left:3px solid transparent; }
      .nav-tab.active { border-bottom:none; border-left-color:#007bff; }
      .go-back-button { position:static; transform:none; margin-top:15px; width:100%; text-align:center; }
      .quick-info,.detailed-features { flex-direction:column; }
    }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <div class="property-container">
    <!-- Tabs -->
    <div class="nav-tabs">
      <div class="nav-tab active" data-tab="overview">Overview</div>
      <div class="nav-tab" data-tab="gallery">Gallery</div>
      <% if (property.plants && property.plants.length > 0) { %>
        <div class="nav-tab" data-tab="plants">Blueprints</div>
      <% } %>
      <% if (property.videos && property.videos.length > 0) { %>
        <div class="nav-tab" data-tab="videos">Videos</div>
      <% } %>
      <a href="/properties" class="go-back-button">← Back</a>
    </div>

    <!-- Overview -->
    <div id="overview-section" class="tab-content active">
      <div class="main-image-container">
        <h2><%= property.title %></h2>
        <% if (property.images && property.images.length > 0) { %>
          <img src="<%= property.images[0] %>" alt="<%= property.title %>" class="main-image" loading="eager">
        <% } %>
      </div>

      <div class="quick-info">
        <div class="info-box">
          <h3><%= {'en':'Price','pt-PT':'Preço','es':'Precio','fr':'Prix'}[getCurrentLanguage()] || 'Price' %></h3>
          <p class="price"><%= property.price %></p>
        </div>
        <div class="info-box">
          <h3><%= {'en':'Area','pt-PT':'Área','es':'Área','fr':'Superficie'}[getCurrentLanguage()] || 'Area' %></h3>
          <p><%= property.area %></p>
        </div>
        <div class="info-box">
          <h3><%= {'en':'Typology','pt-PT':'Tipologia','es':'Tipología','fr':'Typologie'}[getCurrentLanguage()] || 'Typology' %></h3>
          <p><%= property.bedrooms ? 'T' + property.bedrooms : ({'en':'Land','pt-PT':'Terreno','es':'Terreno','fr':'Terrain'}[getCurrentLanguage()] || 'Land') %></p>
        </div>
        <div class="info-box">
          <h3><%= {'en':'Location','pt-PT':'Localização','es':'Ubicación','fr':'Localisation'}[getCurrentLanguage()] || 'Location' %></h3>
          <p><%= property.location %></p>
          <a href="#overview-map-section" class="view-map">
            <%= {'en':'See on Map','pt-PT':'Ver no Mapa','es':'Ver en Mapa','fr':'Voir sur la Carte'}[getCurrentLanguage()] || 'See on Map' %>
          </a>
        </div>
      </div>

      <div class="description-section">
        <h2><%= {'en':'Description','pt-PT':'Descrição','es':'Descripción','fr':'Description'}[getCurrentLanguage()] || 'Description' %></h2>
        <div class="property-description">
          <% property.description.split('\n\n').forEach(para => { %>
            <% if (para.startsWith('**') && para.endsWith('**')) { %>
              <h3 class="description-subheader"><%= para.replace(/\*\*/g,'') %></h3>
            <% } else if (para.startsWith('- ')) { %>
              <ul class="description-features">
                <% para.split('\n').forEach(item => { %><li><%= item.replace('- ','') %></li><% }); %>
              </ul>
            <% } else { %>
              <p><%= para %></p>
            <% } %>
          <% }); %>
        </div>
      </div>

      <div class="detailed-features">
        <% const cats = [
          {key:'specific', title:{'en':'Specific Features','pt-PT':'Características específicas','es':'Características específicas','fr':'Caractéristiques spécifiques'}},
          {key:'urban',    title:{'en':'Urban Situation','pt-PT':'Situação urbanística','es':'Situación urbanística','fr':'Situation urbanistique'}},
          {key:'equipment',title:{'en':'Equipment','pt-PT':'Equipamento','es':'Equipamiento','fr':'Équipement'}},
          {key:'energy',   title:{'en':'Energy Certificate','pt-PT':'Certificado energético','es':'Certificado energético','fr':'Certificat énergétique'}}
        ]; %>
        <% cats.forEach(cat => { %>
          <% if (property.detailedFeatures[cat.key] && property.detailedFeatures[cat.key].length > 0) { %>
            <div class="feature-category">
              <h3><%= cat.title[getCurrentLanguage()] || cat.title['en'] %></h3>
              <ul>
                <% property.detailedFeatures[cat.key].forEach(item => { %>
                  <% if (cat.key === 'energy') { %>
                    <% const m = item.match(/Class ([A-G])/); %>
                    <li>Class: <span class="energy-house <%= m ? 'energy-' + m[1] : '' %>"><%= m ? m[1] : '' %></span></li>
                  <% } else { %>
                    <li><%= item %></li>
                  <% } %>
                <% }); %>
              </ul>
            </div>
          <% } %>
        <% }); %>
      </div>

      <div id="overview-map-section" class="map-section-in-overview">
        <h2><%= {'en':'Location','pt-PT':'Localização','es':'Ubicación','fr':'Localisation'}[getCurrentLanguage()] || 'Location' %></h2>
        <div id="overview-map"
             data-lat="<%= property.coordinates.latitude %>"
             data-lng="<%= property.coordinates.longitude %>"
             data-title="<%= property.title %>">
          <div id="overview-map-loading" class="map-loading">
            <%= {'en':'Loading map…','pt-PT':'A carregar mapa…','es':'Cargando mapa…','fr':'Chargement de la carte…'}[getCurrentLanguage()] || 'Loading map…' %>
          </div>
        </div>
        <a href="https://maps.google.com/maps?q=<%= property.coordinates.latitude %>,<%= property.coordinates.longitude %>"
           target="_blank" rel="noopener" class="open-in-maps">
          <%= {'en':'Open in Google Maps','pt-PT':'Abrir no Google Maps','es':'Abrir en Google Maps','fr':'Ouvrir dans Google Maps'}[getCurrentLanguage()] || 'Open in Google Maps' %>
        </a>
      </div>
    </div><!-- /overview -->

    <!-- Gallery -->
    <div id="gallery-section" class="tab-content gallery-section">
      <h2><%= property.title %></h2>
      <div class="gallery">
        <% if (!property.images || property.images.length === 0) { %>
          <p><%= {'en':'No images available.','pt-PT':'Nenhuma imagem disponível.'}[getCurrentLanguage()] || 'No images available.' %></p>
        <% } else { %>
          <% property.images.forEach((image, index) => { %>
            <img src="<%= image %>" alt="<%= property.title %> – foto <%= index + 1 %>" class="gallery-item" loading="lazy">
          <% }); %>
        <% } %>
      </div>
    </div>

    <!-- Plants / Blueprints -->
    <% if (property.plants && property.plants.length > 0) { %>
      <div id="plants-section" class="tab-content gallery-section">
        <h2><%= property.title %></h2>
        <div class="gallery">
          <% property.plants.forEach((plant, index) => { %>
            <img src="<%= plant %>" alt="<%= property.title %> – planta <%= index + 1 %>" class="gallery-item" loading="lazy">
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Videos -->
    <% if (property.videos && property.videos.length > 0) { %>
      <div id="videos-section" class="tab-content gallery-section">
        <h2><%= property.title %></h2>
        <div class="gallery">
          <% property.videos.forEach((video, index) => { %>
            <video controls class="gallery-item video" preload="metadata"
                   aria-label="<%= property.title %> – vídeo <%= index + 1 %>">
              <source src="<%= video %>" type="video/mp4">
            </video>
          <% }); %>
        </div>
      </div>
    <% } %>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox" style="display:none;">
      <span class="close-lightbox" onclick="closeLightbox()">×</span>
      <img id="lightbox-image" src="" alt="Imagem ampliada">
    </div>
  </div><!-- /property-container -->

  <script>
    let overviewMapInitialized = false;

    function initAllMaps() {
      if (typeof initPropertyMap === 'function') {
        initPropertyMap('overview-map', 'overview-map-loading');
        overviewMapInitialized = true;
      }
    }

    // Tab navigation
    document.querySelectorAll('.nav-tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.nav-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
        tab.classList.add('active');
        const section = document.getElementById(tab.dataset.tab + '-section');
        if (section) section.classList.add('active');
      });
    });

    // Lightbox
    document.querySelectorAll('.gallery-item:not(.video)').forEach(img => {
      img.addEventListener('click', () => {
        document.getElementById('lightbox-image').src = img.src;
        document.getElementById('lightbox').style.display = 'flex';
      });
    });

    function closeLightbox() {
      document.getElementById('lightbox').style.display = 'none';
    }

    // Smooth scroll to map
    document.querySelector('.view-map')?.addEventListener('click', e => {
      e.preventDefault();
      document.getElementById('overview-map-section')?.scrollIntoView({ behavior: 'smooth' });
      if (!overviewMapInitialized && typeof google !== 'undefined' && typeof initPropertyMap === 'function') {
        initPropertyMap('overview-map', 'overview-map-loading');
        overviewMapInitialized = true;
      }
    });
  </script>

  <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&loading=async&libraries=marker&v=beta&callback=initAllMaps" async defer></script>

  <%- include('partials/footer') %>
</body>
</html>
