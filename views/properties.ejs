<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Properties for Sale - MeetMyHomes</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    .container { max-width:1200px; margin:0 auto; padding:0 1.5rem; }
    .properties-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(300px,1fr)); gap:2.5rem; margin:3rem 0; }
    .property-card { border:1px solid #eaeaea; border-radius:10px; overflow:hidden; background:#fff; transition:transform .3s,box-shadow .3s; box-shadow:0 2px 5px rgba(0,0,0,.1); }
    .property-card:hover { transform:translateY(-8px); box-shadow:0 6px 15px rgba(0,0,0,.15); }
    .property-image { width:100%; height:250px; object-fit:cover; }
    .property-info { padding:1.8rem; background:#f8f9fa; }
    .price { font-size:1.7rem; font-weight:700; color:#2c3e50; margin-bottom:.5rem; }
    .property-info h2 { font-size:1.4rem; color:#2c3e50; margin:.5rem 0; font-weight:600; line-height:1.3; }
    .property-info p { font-size:1rem; color:#34495e; margin:.3rem 0; }
    .features { display:flex; flex-wrap:wrap; gap:.7rem; margin:1.2rem 0 .5rem; }
    .feature { background:#f8f9fa; padding:.4rem 1rem; border-radius:20px; font-size:.95rem; color:#2c3e50; border:1px solid #dfe6e9; }
    a { text-decoration:none; color:inherit; }
    @media (max-width:768px) { .properties-grid { grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:2rem; } .property-image { height:200px; } }
    @media (max-width:480px) { .properties-grid { grid-template-columns:1fr; } .property-image { height:180px; } }
  </style>
</head>
<body>
  <%- include('partials/header') %>

  <main class="container">
    <h1>Properties for Sale</h1>
    <div class="properties-grid">
      <% properties.forEach(property => { %>
        <div class="property-card">
          <a href="/properties/<%= property.id %>">
            <% const thumb = (property.images && property.images[0]) ? property.images[0] : '/images/fallback.jpg'; %>
            <img src="<%= thumb %>" alt="<%= property.title %>" class="property-image" loading="lazy">
            <div class="property-info">
              <div class="price"><%= property.price %></div>
              <h2><%= property.title %></h2>
              <p><%= property.location %></p>
              <div class="features">
                <span class="feature"><%= property.area %></span>
                <% if (property.bedrooms) { %><span class="feature"><%= property.bedrooms %> quartos</span><% } %>
                <% if (property.bathrooms) { %><span class="feature"><%= property.bathrooms %> WC</span><% } %>
                <% if (property.propertyType === 'terrain') { %><span class="feature">Terreno</span><% } %>
              </div>
            </div>
          </a>
        </div>
      <% }); %>
    </div>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
