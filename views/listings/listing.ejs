<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= listing.title %> - MeetMyHomes</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/css/listing.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500&display=swap">
  <% if (listing.images && listing.images[0]) { %>
    <link rel="preload" href="<%= listing.images[0] %>" as="image">
  <% } %>
  <style>
    .modal { display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,.5); z-index:1000; }
    .modal-content { background:#fff; margin:15% auto; padding:20px; border-radius:5px; width:90%; max-width:400px; text-align:center; position:relative; }
    .close-modal { position:absolute; top:10px; right:15px; font-size:24px; cursor:pointer; color:#333; }
    .contact-info { margin-top:20px; }
    .contact-info p { margin:10px 0; font-size:16px; }
    .contact-btn { float:right; padding:10px 20px; background:#f8f9fa; color:#2c3e50; text-decoration:none; border-radius:25px; font-size:1.1rem; font-weight:600; border:2px solid #79a9ee; cursor:pointer; transition:background .3s,transform .2s; }
    .contact-btn:hover { background:#dfe6e9; transform:translateY(-2px); }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <div class="listing-container">
    <!-- Basic Info -->
    <div class="listing-section">
      <h1><%= listing.title %></h1>
      <div class="property-meta">
        <span><i class="fas fa-map-marker-alt"></i> <%= listing.location %></span>
        <% if (listing.rating) { %>
          <span><i class="fas fa-star filled"></i> <%= listing.rating %></span>
        <% } %>
      </div>
      <div class="price-section">
        <span class="price"><%= listing.pricePerNight %></span>
        <span class="text-muted"> / night</span>
        <button class="contact-btn" id="contact-btn">Contact Host</button>
      </div>
    </div>

    <!-- Gallery -->
    <div class="gallery-section">
      <div class="thumbnail-grid">
        <% listing.images.slice(0, 5).forEach((image, index) => { %>
          <div class="grid-item">
            <img src="<%= image %>"
                 class="grid-thumb <%= index === 0 ? 'active' : '' %>"
                 data-index="<%= index %>"
                 alt="Photo <%= index + 1 %>"
                 loading="<%= index === 0 ? 'eager' : 'lazy' %>">
          </div>
        <% }); %>
        <% if (listing.images.length > 5) { %>
          <div class="grid-item see-more-container">
            <button class="see-more-btn" id="see-more-btn">
              <span>See More</span>
              <i class="fas fa-chevron-right"></i>
              <div class="photo-count">+<%= listing.images.length - 5 %></div>
            </button>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Photo Modal -->
    <%- include('../partials/photo-modal', { images: listing.images, listing: listing }) %>

    <!-- Contact Modal -->
    <div id="contact-modal" class="modal">
      <div class="modal-content">
        <span class="close-modal">&times;</span>
        <h2>Contact Information</h2>
        <div class="contact-info">
          <p><strong>Host:</strong> <%= listing.host.name %></p>
          <p><strong>Email:</strong> <%= listing.host.email || 'geral@meetmyhomes.com' %></p>
          <p><strong>Phone:</strong> <%= listing.host.phone || '(+351) 964 696 600' %></p>
        </div>
      </div>
    </div>

    <!-- Amenities -->
    <% const amenitiesShown = 8; %>
    <div class="listing-section">
      <h2>What this place offers</h2>
      <ul class="amenities collapsible-list" id="amenities-list">
        <% listing.amenities.forEach((amenity, i) => { %>
          <li class="<%= i >= amenitiesShown ? 'hidden-item' : '' %>">
            <i class="fas <%= amenity.icon %>"></i>
            <span><%= amenity.name %></span>
          </li>
        <% }); %>
      </ul>
      <% if (listing.amenities.length > amenitiesShown) { %>
        <button class="toggle-list-btn" data-target="amenities-list"
                data-more-label="Show all <%= listing.amenities.length %> amenities"
                data-less-label="Show less">
          <span class="toggle-label">Show all <%= listing.amenities.length %> amenities</span>
          <i class="fas fa-chevron-down"></i>
        </button>
      <% } %>
    </div>

    <!-- Description -->
    <% const isLongDescription = listing.description.length > 500; %>
    <div class="listing-section">
      <h2>About this place</h2>
      <div class="property-description <%= isLongDescription ? 'collapsed' : '' %>" id="property-description">
        <% listing.description.split('\n\n').forEach(para => { %>
          <% if (para.startsWith('**') && para.endsWith('**')) { %>
            <h3 class="description-subheader"><%= para.replace(/\*\*/g, '') %></h3>
          <% } else if (para.startsWith('- ')) { %>
            <ul class="description-features">
              <% para.split('\n').forEach(item => { %><li><%= item.replace('- ', '') %></li><% }); %>
            </ul>
          <% } else { %>
            <p><%= para %></p>
          <% } %>
        <% }); %>
      </div>
      <% if (isLongDescription) { %>
        <button class="toggle-list-btn" data-collapse-target="property-description">
          <span class="toggle-label">Read more</span>
          <i class="fas fa-chevron-down"></i>
        </button>
      <% } %>
    </div>

    <!-- Map -->
    <div class="listing-section">
      <h2>Location</h2>
      <% if (listing.coordinates) { %>
        <div id="property-map"
             data-lat="<%= listing.coordinates.latitude %>"
             data-lng="<%= listing.coordinates.longitude %>"
             data-title="<%= listing.title %>">
          <div class="map-loading">Loading map…</div>
        </div>
        <a href="https://maps.google.com/maps?q=<%= listing.coordinates.latitude %>,<%= listing.coordinates.longitude %>"
           target="_blank" rel="noopener" class="open-in-maps">
          <i class="fas fa-external-link-alt"></i> Open in Google Maps
        </a>
      <% } %>
      <% if (listing.locationDescription) { %>
        <% const isLongLocationDesc = listing.locationDescription.length > 400; %>
        <div class="property-description location-description <%= isLongLocationDesc ? 'collapsed' : '' %>" id="location-description">
          <% listing.locationDescription.split('\n\n').forEach(para => { %>
            <p><%= para %></p>
          <% }); %>
        </div>
        <% if (isLongLocationDesc) { %>
          <button class="toggle-list-btn" data-collapse-target="location-description">
            <span class="toggle-label">Read more</span>
            <i class="fas fa-chevron-down"></i>
          </button>
        <% } %>
      <% } %>
    </div>

    <!-- Host -->
    <div class="listing-section">
      <h2>Hosted by <%= listing.host.name %></h2>
      <div class="host-description">
        <div class="host-info">
          <% if (listing.host.superhost) { %>
            <p><span class="superhost-badge">Superhost</span> · Hosting since <%= listing.host.since %></p>
          <% } else { %>
            <p>Hosting since <%= listing.host.since %></p>
          <% } %>
          <p><%= listing.host.description %></p>
        </div>
        <% if (listing.host.image) { %>
          <img src="<%= listing.host.image %>" alt="<%= listing.host.name %>" class="host-image">
        <% } %>
      </div>
    </div>

    <!-- Reviews -->
    <% if (listing.reviews && listing.reviews.length > 0) { %>
      <div class="listing-section">
        <h2>Reviews</h2>
        <% listing.reviews.forEach(review => { %>
          <div class="review-card">
            <div class="review-header">
              <strong><%= review.author %></strong>
              <div class="review-rating">
                <% for (let i = 0; i < 5; i++) { %>
                  <i class="fas fa-star <%= i < review.rating ? 'filled' : '' %>"></i>
                <% } %>
              </div>
            </div>
            <p class="review-text">"<%= review.comment %>"</p>
            <p class="review-date text-muted">Reviewed on <%= review.date %></p>
          </div>
        <% }); %>
      </div>
    <% } %>

    <!-- House Rules -->
    <% const rulesShown = 4; %>
    <div class="listing-section">
      <h2>House Rules</h2>
      <ul class="house-rules collapsible-list" id="house-rules-list">
        <% listing.houseRules.forEach((rule, i) => { %>
          <li class="<%= i >= rulesShown ? 'hidden-item' : '' %>">
            <% const r = rule.toLowerCase(); %>
            <% if (r.includes('smok')) { %><i class="fas fa-smoking-ban"></i>
            <% } else if (r.includes('pet')) { %><i class="fas fa-paw"></i>
            <% } else if (r.includes('check-in') || r.includes('check in')) { %><i class="fas fa-right-to-bracket"></i>
            <% } else if (r.includes('check-out') || r.includes('check out')) { %><i class="fas fa-right-from-bracket"></i>
            <% } else if (r.includes('guest')) { %><i class="fas fa-users"></i>
            <% } else if (r.includes('part') || r.includes('event')) { %><i class="fas fa-champagne-glasses"></i>
            <% } else if (r.includes('quiet')) { %><i class="fas fa-volume-xmark"></i>
            <% } else { %><i class="fas fa-circle-check"></i>
            <% } %>
            <span><%= rule %></span>
          </li>
        <% }); %>
      </ul>
      <% if (listing.houseRules.length > rulesShown) { %>
        <button class="toggle-list-btn" data-target="house-rules-list"
                data-more-label="Show all <%= listing.houseRules.length %> house rules"
                data-less-label="Show less">
          <span class="toggle-label">Show all <%= listing.houseRules.length %> house rules</span>
          <i class="fas fa-chevron-down"></i>
        </button>
      <% } %>
    </div>
  </div><!-- /listing-container -->

  <%- include('../partials/footer') %>

  <script src="/js/listing.js"></script>
  <script>
    document.getElementById('contact-btn').addEventListener('click', () => {
      document.getElementById('contact-modal').style.display = 'block';
    });
    document.querySelector('.close-modal').addEventListener('click', () => {
      document.getElementById('contact-modal').style.display = 'none';
    });
    window.addEventListener('click', e => {
      if (e.target === document.getElementById('contact-modal'))
        document.getElementById('contact-modal').style.display = 'none';
    });
  </script>

  <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&loading=async&libraries=marker&v=beta&callback=initMap" async defer></script>
</body>
</html>
