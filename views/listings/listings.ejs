<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vacation Rentals - MeetMyHomes</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .page-container { max-width:1200px; margin:0 auto; padding:20px; }
    .page-title { text-align:center; margin-bottom:30px; color:#333; }
    .listing-container { display:flex; margin-bottom:40px; gap:30px; border:1px solid #e0e0e0; border-radius:12px; overflow:hidden; transition:transform .3s,box-shadow .3s; background:#fff; }
    .listing-container:hover { transform:translateY(-5px); box-shadow:0 10px 20px rgba(0,0,0,.1); }
    .image-section { flex:1; min-width:400px; position:relative; }
    .main-image-container { height:300px; overflow:hidden; position:relative; }
    .main-image { width:100%; height:100%; object-fit:cover; }
    .thumbnail-container { display:flex; gap:10px; padding:10px; overflow-x:auto; }
    .thumbnail { width:80px; height:60px; object-fit:cover; border-radius:4px; cursor:pointer; border:2px solid transparent; }
    .thumbnail.active { border-color:#FF385C; }
    .image-controls { position:absolute; top:50%; left:0; width:100%; transform:translateY(-50%); z-index:10; }
    .image-controls button { position:absolute; background:rgba(255,255,255,.7); border:none; width:40px; height:40px; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:1.5rem; color:#333; }
    .image-controls .prev-image-btn { left:10px; }
    .image-controls .next-image-btn { right:10px; }
    .image-controls button:hover { background:#fff; }
    .details-section { flex:1; padding:20px; display:flex; flex-direction:column; }
    .property-header { display:flex; justify-content:space-between; margin-bottom:15px; }
    .property-title { margin:0; font-size:1.5rem; font-weight:600; color:#333; }
    .property-rating { display:flex; align-items:center; }
    .property-rating i { color:#FF385C; margin-right:4px; }
    .property-meta { color:#717171; margin-bottom:15px; }
    .property-price { font-size:1.3rem; font-weight:600; margin:15px 0; }
    .price-period { color:#717171; font-size:1rem; }
    .superhost-badge { display:inline-block; background:#FF385C; color:#fff; padding:4px 10px; border-radius:4px; font-size:.8rem; margin-bottom:15px; }
    .amenities { margin:20px 0; }
    .amenity-item { display:flex; align-items:center; gap:8px; margin-bottom:8px; color:#333; }
    .view-details-btn { display:inline-block; padding:12px 20px; background:#FF385C; color:#fff; text-align:center; text-decoration:none; border-radius:8px; border:none; cursor:pointer; font-size:1rem; font-weight:500; margin-top:auto; align-self:flex-start; transition:background .3s; }
    .view-details-btn:hover { background:#E61E4D; }
    @media (max-width:768px) { .listing-container { flex-direction:column; } .image-section { min-width:100%; } }

    /* Overview map */
    .listings-map-section {
      background: #fff;
      border-radius: 12px;
      padding: 12px;
      margin-bottom: 30px;
      box-shadow: 0 2px 15px rgba(0,0,0,0.05);
    }
    #listings-map {
      height: 420px;
      width: 100%;
      border-radius: 8px;
      overflow: hidden;
      background: #f8f9fa;
    }
    .map-loading {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #888;
    }
    .map-info-window { font-family: 'Roboto', sans-serif; }
    .map-info-window h3 { margin: 0 0 4px; font-size: 0.95rem; }
    .map-info-window p { margin: 0 0 8px; font-size: 0.85rem; color: #666; }
    .map-info-window a { color: #FF385C; font-weight: 600; text-decoration: none; font-size: 0.85rem; }

    /* Search filters */
    .filters-bar {
      background: #fff;
      border-radius: 12px;
      padding: 20px 24px;
      margin-bottom: 30px;
      box-shadow: 0 2px 15px rgba(0,0,0,0.05);
    }
    .filters-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
      gap: 16px;
      align-items: end;
    }
    .filter-field { display: flex; flex-direction: column; gap: 6px; }
    .filter-field label { font-size: 0.82rem; font-weight: 600; color: #555; }
    .filter-field select,
    .filter-field input[type="number"] {
      padding: 9px 10px;
      border: 1.5px solid #ddd;
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: inherit;
      color: #222;
      background: #fff;
    }
    .filter-field select:focus,
    .filter-field input[type="number"]:focus {
      outline: none;
      border-color: #FF385C;
    }
    .price-range-inputs { display: flex; align-items: center; gap: 8px; }
    .price-range-inputs input { width: 100%; min-width: 0; }
    .filter-clear-btn {
      padding: 9px 16px;
      background: #fff;
      border: 1.5px solid #222;
      border-radius: 8px;
      font-weight: 600;
      font-size: 0.9rem;
      color: #222;
      cursor: pointer;
      transition: background 0.2s;
      white-space: nowrap;
    }
    .filter-clear-btn:hover { background: #f2f2f2; }

    .filters-result-count {
      margin: -10px 0 20px;
      color: #717171;
      font-size: 0.95rem;
    }
    .no-results-message {
      display: none;
      text-align: center;
      color: #717171;
      padding: 50px 0;
      font-size: 1.05rem;
    }
  </style>
</head>
<body>
  <%- include('../partials/header') %>

  <div class="page-container">
    <h1 class="page-title">Home Rentals</h1>

    <div class="listings-map-section">
      <div id="listings-map"
           data-listings='<%- JSON.stringify(listings
             .filter(l => l.coordinates && l.coordinates.latitude && l.coordinates.longitude)
             .map(l => ({ id: l.id, title: l.title, location: l.location, lat: l.coordinates.latitude, lng: l.coordinates.longitude }))
           ) %>'>
        <div class="map-loading">Loading map…</div>
      </div>
    </div>

    <div class="filters-bar" id="filters-bar">
      <div class="filters-row">
        <div class="filter-field">
          <label for="filter-location">Location</label>
          <select id="filter-location">
            <option value="">Any location</option>
            <% filterOptions.locations.forEach(loc => { %>
              <option value="<%= loc %>"><%= loc %></option>
            <% }); %>
          </select>
        </div>

        <div class="filter-field">
          <label for="filter-bedrooms">Bedrooms</label>
          <select id="filter-bedrooms">
            <option value="0">Any</option>
            <option value="1">1+</option>
            <option value="2">2+</option>
            <option value="3">3+</option>
            <option value="4">4+</option>
          </select>
        </div>

        <div class="filter-field">
          <label for="filter-guests">Guests</label>
          <select id="filter-guests">
            <option value="0">Any</option>
            <% for (let g = 1; g <= filterOptions.maxGuests; g++) { %>
              <option value="<%= g %>"><%= g %>+</option>
            <% } %>
          </select>
        </div>

        <div class="filter-field">
          <label>Price per night (€)</label>
          <div class="price-range-inputs">
            <input type="number" id="filter-price-min" min="0" placeholder="Min">
            <span>–</span>
            <input type="number" id="filter-price-max" min="0" placeholder="Max <%= filterOptions.maxPrice %>">
          </div>
        </div>

        <button type="button" class="filter-clear-btn" id="filter-clear-btn">Clear filters</button>
      </div>
    </div>

    <p class="filters-result-count" id="filters-result-count"></p>

    <% if (listings && listings.length > 0) { %>
      <% listings.forEach(listing => { %>
        <div class="listing-container"
             id="listing-<%= listing.id %>"
             data-images='<%= JSON.stringify(listing.images) %>'
             data-location="<%= listing.location %>"
             data-price="<%= listing.priceValue %>"
             data-bedrooms="<%= listing.bedrooms || 0 %>"
             data-guests="<%= listing.guests || 0 %>">
          <div class="image-section">
            <div class="main-image-container">
              <img src="<%= listing.images[0] || '/images/fallback.jpg' %>" alt="<%= listing.title %>" class="main-image">
              <div class="image-controls">
                <button class="prev-image-btn" aria-label="Previous">&lt;</button>
                <button class="next-image-btn" aria-label="Next">&gt;</button>
              </div>
            </div>
            <div class="thumbnail-container">
              <% listing.images.slice(0,8).forEach((image, index) => { %>
                <img src="<%= image %>" alt="Thumbnail <%= index+1 %>" class="thumbnail <%= index === 0 ? 'active' : '' %>" data-index="<%= index %>">
              <% }); %>
            </div>
          </div>

          <div class="details-section">
            <div class="property-header">
              <h2 class="property-title notranslate" translate="no"><%= listing.title %></h2>
              <% if (listing.rating) { %>
                <div class="property-rating"><i class="fas fa-star"></i><span><%= listing.rating %></span></div>
              <% } %>
            </div>
            <p class="property-meta"><%= listing.location %> · <%= listing.type %></p>
            <% if (listing.superhost) { %><span class="superhost-badge">Superhost</span><% } %>
            <div class="property-price">
              <span><%= listing.pricePerNight %></span>
              <span class="price-period"> / night</span>
            </div>
            <div class="amenities">
              <h3>Main Features</h3>
              <% if (listing.bedrooms) { %><div class="amenity-item"><i class="fas fa-bed"></i><span><%= listing.bedrooms %> bedrooms</span></div><% } %>
              <% if (listing.bathrooms) { %><div class="amenity-item"><i class="fas fa-bath"></i><span><%= listing.bathrooms %> bathrooms</span></div><% } %>
              <% if (listing.guests) { %><div class="amenity-item"><i class="fas fa-user-friends"></i><span>Sleeps <%= listing.guests %></span></div><% } %>
            </div>
            <p><%= listing.description.substring(0,120) %>…</p>
            <a href="/listings/<%= listing.id %>" class="view-details-btn">View Details</a>
          </div>
        </div>
      <% }); %>
      <p class="no-results-message" id="no-results-message">No rentals match your search. Try adjusting or clearing the filters.</p>
    <% } else { %>
      <p style="text-align:center;color:#717171;padding:40px 0">No rentals available at the moment.</p>
    <% } %>
  </div>

  <%- include('../partials/footer') %>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.listing-container').forEach(container => {
        const images = JSON.parse(container.dataset.images);
        const mainImg = container.querySelector('.main-image');
        const thumbs  = container.querySelectorAll('.thumbnail');
        let current   = 0;

        if (images.length <= 1) container.querySelector('.image-controls').style.display = 'none';

        const update = i => {
          current = i;
          mainImg.src = images[current];
          thumbs.forEach((t, j) => t.classList.toggle('active', j === current));
        };

        container.querySelector('.prev-image-btn').addEventListener('click', e => { e.stopPropagation(); update((current - 1 + images.length) % images.length); });
        container.querySelector('.next-image-btn').addEventListener('click', e => { e.stopPropagation(); update((current + 1) % images.length); });
        thumbs.forEach(t => t.addEventListener('click', () => update(parseInt(t.dataset.index))));
      });

      // ── Search filters ──────────────────────────────────────────────────
      const cards        = [...document.querySelectorAll('.listing-container')];
      const locationSel  = document.getElementById('filter-location');
      const bedroomsSel  = document.getElementById('filter-bedrooms');
      const guestsSel    = document.getElementById('filter-guests');
      const priceMinInp  = document.getElementById('filter-price-min');
      const priceMaxInp  = document.getElementById('filter-price-max');
      const clearBtn      = document.getElementById('filter-clear-btn');
      const resultCountEl = document.getElementById('filters-result-count');
      const noResultsEl   = document.getElementById('no-results-message');

      if (!cards.length || !locationSel) return; // nothing to filter (empty state page)

      function applyFilters() {
        const location   = locationSel.value;
        const minBedrooms = parseInt(bedroomsSel.value, 10) || 0;
        const minGuests    = parseInt(guestsSel.value, 10) || 0;
        const minPrice     = priceMinInp.value ? parseFloat(priceMinInp.value) : null;
        const maxPrice     = priceMaxInp.value ? parseFloat(priceMaxInp.value) : null;

        let visibleCount = 0;

        cards.forEach(card => {
          const price     = parseFloat(card.dataset.price) || 0;
          const bedrooms  = parseInt(card.dataset.bedrooms, 10) || 0;
          const guests    = parseInt(card.dataset.guests, 10) || 0;

          const matches =
            (!location || card.dataset.location === location) &&
            bedrooms >= minBedrooms &&
            guests >= minGuests &&
            (minPrice === null || price >= minPrice) &&
            (maxPrice === null || price <= maxPrice);

          card.style.display = matches ? '' : 'none';
          if (matches) visibleCount++;
        });

        resultCountEl.textContent = visibleCount === cards.length
          ? `${cards.length} rentals`
          : `${visibleCount} of ${cards.length} rentals match your search`;
        noResultsEl.style.display = visibleCount === 0 ? 'block' : 'none';
      }

      [locationSel, bedroomsSel, guestsSel].forEach(el => el.addEventListener('change', applyFilters));
      [priceMinInp, priceMaxInp].forEach(el => el.addEventListener('input', applyFilters));

      clearBtn.addEventListener('click', () => {
        locationSel.value = '';
        bedroomsSel.value = '0';
        guestsSel.value = '0';
        priceMinInp.value = '';
        priceMaxInp.value = '';
        applyFilters();
      });

      applyFilters();
    });
  </script>

  <script src="/js/listingsMap.js"></script>
  <script src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&loading=async&libraries=marker&v=beta&callback=initListingsMap" async defer></script>
</body>
</html>
